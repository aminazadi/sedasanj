FROM pytorch/pytorch:2.7.1-cuda12.6-cudnn9-devel

ARG PIP_INDEX_URL=https://mirror.novin.cloud/artifactory/api/pypi/pypi/simple/
ARG PIP_EXTRA_INDEX_URL=
ARG PIP_DEFAULT_TIMEOUT=600
ARG APT_UBUNTU_MIRRORS="https://mirror.arvancloud.ir/ubuntu/ https://mirrors.ustc.edu.cn/ubuntu/ https://mirrors.tuna.tsinghua.edu.cn/ubuntu/"
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=${PIP_DEFAULT_TIMEOUT} \
    PIP_RETRIES=15 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CMAKE_ARGS=-DGGML_CUDA=on \
    CMAKE_BUILD_PARALLEL_LEVEL=4 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ASR_DATA_DIR=/data \
    ASR_MODELS_DIR=/data/models \
    ASR_FORWARDED_ALLOW_IPS=127.0.0.1,172.29.0.0/16

COPY docker/install-gpu-apt-packages.sh /usr/local/bin/install-gpu-apt-packages
RUN APT_UBUNTU_MIRRORS="${APT_UBUNTU_MIRRORS}" sh /usr/local/bin/install-gpu-apt-packages
WORKDIR /app
COPY requirements-runtime.txt requirements-build.txt ./
RUN python -m pip install --retries 15 --timeout "${PIP_DEFAULT_TIMEOUT}" \
    -r requirements-runtime.txt -r requirements-build.txt \
    && python -m pip install --retries 15 --timeout "${PIP_DEFAULT_TIMEOUT}" \
       --force-reinstall --no-deps --no-binary=llama-cpp-python llama-cpp-python==0.3.16 \
    && python -c "from llama_cpp import llama_supports_gpu_offload; assert llama_supports_gpu_offload(), 'llama.cpp CUDA backend was not built'"
COPY app.py ./
COPY asr_service ./asr_service
RUN useradd --create-home --uid 10001 asr \
    && mkdir -p /data/models \
    && chown -R asr:asr /app /data
USER asr
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/live || exit 1
CMD ["sh","-c","exec uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips \"$ASR_FORWARDED_ALLOW_IPS\""]
