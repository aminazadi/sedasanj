ASR_CPU_THREADS=0
# Native libraries use whole threads; this reserves at least ~5% CPU on multi-core hosts.
ASR_CPU_BUDGET_PERCENT=90
# 0 = adaptive auto; hard ceiling is derived from CPU capacity.
ASR_MAX_CONCURRENT=0
ASR_TASK_WORKERS=0
ASR_INITIAL_CONCURRENT=1
# Maximum independent llama.cpp model instances. Each instance consumes the
# model's RAM again; set this according to available memory (2 is conservative).
ASR_LLM_MAX_CONCURRENT=2
ASR_DECISION_MAX_CONCURRENT=2
ASR_DECISION_CPU_THREADS=7
ASR_DECISION_QUEUE_LIMIT=256
ASR_DECISION_TIMEOUT_SECONDS=20
ASR_DECISION_CONFIDENCE_THRESHOLD=0.72
ASR_DECISION_SYNC_WAIT_SECONDS=0.25
# A new queued job starts only while live CPU and RAM stay below these limits.
ASR_ADMISSION_CPU_PERCENT=80
ASR_ADMISSION_MEMORY_PERCENT=80
# Minimum CPU threads reserved per parallel ASR job in automatic mode.
ASR_MIN_THREADS_PER_JOB=4
# Safety ceiling for auto mode; the CPU-derived ceiling can be lower.
ASR_AUTO_MAX_CONCURRENT=8
ASR_HTTP_MAX_IN_FLIGHT=128
ASR_SYNC_CHAT_MAX_IN_FLIGHT=16
ASR_HTTP_ADMISSION_WAIT_SECONDS=0.25
ASR_HTTP_MAX_BODY_MB=520
ASR_HTTP_MAX_JSON_BODY_MB=2
ASR_MAX_CONCURRENT_UPLOADS=4
ASR_UPLOAD_ADMISSION_WAIT_SECONDS=0.25
ASR_SPOOL_MAX_MB=8192
ASR_SPOOL_MIN_FREE_MB=2048
ASR_SPOOL_MIN_FREE_PERCENT=10
ASR_SYNC_CHAT_WAIT_SECONDS=120
ASR_MEMORY_LIMIT=32g
ASR_PIDS_LIMIT=512
ASR_QUEUE_LIMIT=100
ASR_QUEUE_MAX_AUDIO_MB=8192
ASR_QUEUE_MAX_MODEL_RUNS=200
ASR_TASK_MAX_ATTEMPTS=2
ASR_CHAT_TASK_TIMEOUT_SECONDS=900
ASR_MAX_MODELS_PER_TASK=5
ASR_TASK_STALE_SECONDS=120
ASR_TASK_RESULT_TTL_HOURS=168
ASR_MAX_UPLOAD_MB=500
# Direct resumable uploads (MinIO, provisioned by docker-compose).
# This must be the browser-reachable NPM hostname, not http://minio:9000.
ASR_S3_ENDPOINT=http://minio:9000
ASR_S3_PUBLIC_ENDPOINT=https://uploads.example.com
ASR_S3_BUCKET=asr-uploads
ASR_S3_REGION=us-east-1
MINIO_ROOT_USER=replace-with-a-minimum-3-character-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_CONSOLE_PUBLIC_URL=https://minio-console.example.com
# Must match the web client origins permitted to PUT direct upload parts.
MINIO_API_CORS_ALLOW_ORIGIN=https://aiservice.voicesanj.ir
ASR_UPLOAD_PART_SIZE_MB=16
ASR_UPLOAD_URL_TTL_SECONDS=900
ASR_UPLOAD_TTL_HOURS=24
# ASR_API_KEY=replace-with-a-long-random-secret
# Optional extra secret mixed into hashes of issued user API keys. Keep it stable after first use.
# ASR_API_KEY_PEPPER=replace-with-another-long-random-secret
# Required before saving a 9Router API key in the administrator UI. Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# ASR_9ROUTER_SECRETS_KEY=replace-with-a-stable-fernet-key
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# 2 balances speed and accuracy on CPU; use 1 for maximum throughput.
ASR_WHISPER_BEAM_SIZE=2
# A single deterministic decode prevents costly temperature-fallback retries.
ASR_WHISPER_TEMPERATURE=0
# Optional: use GTCRN only as a final fallback after the original audio fails
# both with and without VAD. It is deliberately off by default because it can
# suppress quiet or distant speech.
ASR_ENABLE_DENOISER=0
DORNA_CONTEXT_SIZE=12288
DORNA_GPU_LAYERS=0

# Docker build dependency mirror (model downloads are managed in /admin).
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
PIP_EXTRA_INDEX_URL=
PIP_DEFAULT_TIMEOUT=600
