# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local secrets
.env
.env.*
!.env.example
.venv/
venv/
env/

# Packaging and build output
build/
dist/
*.egg-info/

# Runtime data and local tooling
data/
.DS_Store
.idea/
.vscode/
