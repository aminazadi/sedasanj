<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Store build: the store installs updates, so the self-updater permissions and receiver are
         removed (they are only used by the `direct` flavor). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove"/>
    <application>
        <receiver
            android:name=".update.UpdateInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
