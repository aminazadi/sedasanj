# Copy to deploy/.env and fill in. Secrets never go in git (§13).
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
# Public hosts are terminated by the external Nginx Proxy Manager.
AUDIO_DOMAIN=audio.example.com
GRAFANA_DOMAIN=monitor.example.com

# Required production network settings.
# PUBLISH_ADDRESS is an IP assigned to this VPS (public, private, or VPN), not 0.0.0.0.
# Permit these ports at the firewall only from NPM_PROXY_IP.
PUBLISH_ADDRESS=
NPM_PROXY_IP=
APP_PROXY_SUBNET=172.30.0.0/28
APP_PORT=3000
ADMIN_PORT=3001
API_PORT=8000
MINIO_API_PORT=9000
GRAFANA_PORT=3002

POSTGRES_PASSWORD=
# Runtime role: non-superuser so RLS policies apply (§7.2)
APP_DB_PASSWORD=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_DATABASE_MASTER_KEY=
# Generate separately with the same Fernet command; used for admin-managed provider secrets.
PLATFORM_SECRETS_KEY=
TENANT_DATABASES_ENABLED=true
TENANT_DATABASE_AUTO_MIGRATE=true
TENANT_DATABASE_POOL_SIZE=3
TENANT_DATABASE_MAX_POOLS=20
TENANT_MIGRATION_BATCH_SIZE=500
TENANT_MIGRATION_MAX_ATTEMPTS=5
TENANT_MIGRATION_DRAIN_SECONDS=1800
TENANT_MIGRATION_ROLLBACK_DAYS=7
TENANT_BACKUP_ENABLED=true
TENANT_BACKUP_INTERVAL_HOURS=24
TENANT_BACKUP_RETENTION_DAYS=30
AGE_COMMIT=2db2f060c4c9265a14d40f007eb8c56febf31e4c
AGE_VERSION=PG16/v1.6.0-rc0
AGE_COMMIT_PG17=54905a09bf8462f22a87c3adfd2ab5752e5c1e71
JWT_SECRET=
API_KEY_PEPPER=
MINIO_ROOT_USER=cbi
MINIO_ROOT_PASSWORD=
GRAFANA_PASSWORD=
# At least 32 random characters; required in production.
METRICS_TOKEN=
# Keep this aligned with both Nginx layers (512 MiB by default).
MAX_UPLOAD_BYTES=536870912


# Optional
ENVIRONMENT=production
SMTP_URL=smtp://user:pass@smtp.example.com:587
NOTIFY_FROM_EMAIL=noreply@example.com
SMSIR_API_KEY=
SMSIR_VERIFY_TEMPLATE_ID=
SMSIR_BASE_URL=https://api.sms.ir/v1
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PUBLIC_APP_URL=https://app.example.com
SALES_NOTIFICATION_EMAIL=sales@example.com
SUPPORT_EMAIL=support@example.com
LOG_LEVEL=INFO
MODELS_DIR=/srv/models
LLM_GGUF=dorna-llama3-8b-instruct-q4_k_m.gguf
LLM_MODEL=dorna-llama3-8b-instruct-q4_k_m
BUILD_NETWORK=host
PIP_INDEX_URL=https://pypi.org/simple
PRIMARY_DNS=1.1.1.1
SECONDARY_DNS=8.8.8.8

# VoiceSanj remote ASR + LLM (http://aiservice.voicesanj.ir/redoc/user — API v2)
# API key is configured in the admin panel (Settings → کلید API), not here.
ASR_ENGINE=voicesanj
LLM_CLIENT=voicesanj
VOICESANJ_BASE_URL=http://aiservice.voicesanj.ir
VOICESANJ_ASR_MODEL=buzzasr-persian
VOICESANJ_LLM_MODEL=dorna-8b-q4_k_m
AUDIO_PREPROCESSING_ENABLED=false
AUDIO_DENOISER_MODEL=speech-afftdn-balanced
AUDIO_ENHANCEMENT_MODEL=speech-clarity-balanced
VOICESANJ_CORRECTION_TIMEOUT_SECONDS=120
VOICESANJ_LLM_READ_TIMEOUT_SECONDS=900
VOICESANJ_TEXT_CORRECTION_STYLE=formal
ANALYSIS_TIMEOUT_SECONDS=1500
MAX_CONCURRENT_ASR_JOBS=10
MAX_CONCURRENT_LLM_SUBMISSIONS=16
LLM_POLL_INTERVAL_SECONDS=2
OUTBOX_DISPATCH_INTERVAL_SECONDS=1

# Local llama.cpp (only when COMPOSE_PROFILES=local-llm). Defaults fit a small host.
# On a 64-core model VM set e.g. LLM_CPUS=24 LLM_THREADS=20 LLM_PARALLEL=4 LLM_MEMORY=20G
# COMPOSE_PROFILES=local-llm
LLM_CPUS=2
LLM_THREADS=2
LLM_PARALLEL=1
LLM_MEMORY=8G
LLM_CTX_SIZE=8192

# Postgres sizing (raise on large VMs)
PG_CPUS=2
PG_MEMORY=2G
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_CONNECTIONS=100
PG_WORK_MEM=8MB

# Bootstrap accounts (created automatically by the `seed` compose service if missing)
SEED_ON_DEPLOY=true
SEED_TENANT_ID=
SEED_TENANT_NAME=شرکت نمونه
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_API_KEY=
SEED_MINUTES=600
# Set true once to force-update passwords from this file; leave false on normal redeploys
SEED_RESET_PASSWORDS=false
