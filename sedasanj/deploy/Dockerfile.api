FROM python:3.12-slim AS base

ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

RUN sed -i 's|http://deb.debian.org/debian|https://deb.debian.org/debian|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends ffmpeg curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/app
COPY pyproject.toml README.md ./
COPY apps ./apps
COPY scripts ./scripts
RUN pip install --no-cache-dir --retries 5 --timeout 120 \
        "setuptools==75.8.2" "wheel==0.45.1" \
    && pip install --no-cache-dir --retries 5 --timeout 120 \
        "hatchling==1.27.0" "pluggy==1.5.0" \
    && pip install --no-cache-dir --no-build-isolation --retries 5 --timeout 120 .

ENV PYTHONPATH=/srv/app/apps/api:/srv/app/apps/worker_asr:/srv/app/apps/worker_llm:/srv/app/apps/worker_notify:/srv/app/apps/worker_dispatch:/srv/app/apps/worker_provision

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]

FROM base AS emotion
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir --retries 5 --timeout 120 \
        --index-url "${TORCH_INDEX_URL}" "torch==2.14.0" \
    && pip install --no-cache-dir --retries 5 --timeout 120 ".[emotion]"
