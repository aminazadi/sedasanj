# Pinned by digest for reproducible builds; refresh with `docker pull python:3.12-slim` and update the digest.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS base

ARG PIP_INDEX_URL=https://mirror.novin.cloud/artifactory/api/pypi/pypi/simple/
ARG PIP_FALLBACK_INDEX_URLS="https://mirrors.aliyun.com/pypi/simple/ https://mirrors.ustc.edu.cn/pypi/simple/ https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple/"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_FALLBACK_INDEX_URLS=${PIP_FALLBACK_INDEX_URLS} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

RUN sed -i 's|http://deb.debian.org/debian|https://deb.debian.org/debian|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends ffmpeg curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Jalase-Negar APK checks (aapt2 + apksigner). Pinned and verified by SHA-256; when the checksum is
# not supplied the tools are skipped and APK uploads answer apk_inspection_unavailable.
# Fill the checksum of build-tools_r${ANDROID_BUILD_TOOLS_REVISION}_linux.zip from the official
# Android SDK repository manifest. aapt2 is an x86-64 binary: build the image for linux/amd64.
ARG ANDROID_BUILD_TOOLS_REVISION=35
ARG ANDROID_BUILD_TOOLS_SHA256=
RUN if [ -n "${ANDROID_BUILD_TOOLS_SHA256}" ]; then \
        apt-get -o Acquire::Retries=3 update \
        && apt-get install -y --no-install-recommends unzip default-jre-headless \
        && curl -fsSL -o /tmp/build-tools.zip \
            "https://dl.google.com/android/repository/build-tools_r${ANDROID_BUILD_TOOLS_REVISION}_linux.zip" \
        && echo "${ANDROID_BUILD_TOOLS_SHA256}  /tmp/build-tools.zip" | sha256sum -c - \
        && mkdir -p /opt/android-build-tools \
        && unzip -q /tmp/build-tools.zip -d /opt/android-build-tools \
        && tools="$(dirname "$(find /opt/android-build-tools -name aapt2 -type f | head -n 1)")" \
        && ln -s "${tools}/aapt2" /usr/local/bin/aapt2 \
        && ln -s "${tools}/apksigner" /usr/local/bin/apksigner \
        && rm -f /tmp/build-tools.zip \
        && apt-get purge -y --auto-remove unzip \
        && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /srv/app
COPY pyproject.toml README.md ./
COPY apps ./apps
COPY scripts ./scripts
RUN python scripts/install_project_dependencies.py

ENV PYTHONPATH=/srv/app/apps/api:/srv/app/apps/worker_asr:/srv/app/apps/worker_emotion:/srv/app/apps/worker_llm:/srv/app/apps/worker_notify:/srv/app/apps/worker_meeting:/srv/app/apps/worker_dispatch:/srv/app/apps/worker_provision:/srv/app/apps/agent

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]

FROM base AS emotion
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN mkdir -p /tmp/torch-wheel \
    && python -m pip download --no-cache-dir --no-deps --only-binary=:all: \
        --retries 5 --timeout 120 --dest /tmp/torch-wheel \
        --index-url "${TORCH_INDEX_URL}" "torch==2.14.0" \
    && python -m pip install --no-cache-dir --only-binary=:all: --retries 5 --timeout 120 \
        "setuptools==77.0.3" "wheel==0.45.1" /tmp/torch-wheel/torch-*.whl \
    && rm -rf /tmp/torch-wheel \
    && python scripts/install_project_dependencies.py \
        --extra emotion --extra-only --exclude torch --allow-source
