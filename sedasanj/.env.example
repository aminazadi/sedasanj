# Local development services exposed by deploy/compose.local.yml.
DATABASE_URL=postgresql+asyncpg://root:postgres@127.0.0.1:5433/cbi
REDIS_URL=redis://127.0.0.1:6380/0
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=minio123
MINIO_BUCKET_AUDIO=audio

ENVIRONMENT=development
STORAGE_BACKEND=s3
QUEUE_BACKEND=redis
PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_SECRET=change-me-change-me-change-me-32
API_KEY_PEPPER=change-me-change-me-change-me-32

# Keep tenant database provisioning disabled for the single-database local stack.
TENANT_DATABASES_ENABLED=false
TENANT_DATABASE_AUTO_MIGRATE=false
TENANT_BACKUP_ENABLED=false
