{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASR segment (parity contract v1)",
  "description": "One transcript turn as produced by either the server or the device. PROPOSED shape; not yet implemented on either side (contract phase 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "channel",
    "start_ms",
    "end_ms",
    "text",
    "timestamp_source",
    "source"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "channel": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "speaker": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "timestamp_source": {
      "type": "string",
      "enum": [
        "native",
        "vad_window",
        "diarization",
        "silero_vad"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "device",
        "server"
      ]
    }
  }
}
